    "react":     { "duration_ms": 500 },
    "interact":  { "duration_ms": 700 },
    "celebrate": { "duration_ms": 1200 },
    "think":     { "duration_ms": 2400, "loop": true },
    "busy":      { "duration_ms": 1000, "loop": true },
    "warning":   { "duration_ms": 1000 },
    "error":     { "duration_ms": 1200 },
    "sleep":     { "duration_ms": 2600, "loop": true },
    "wake_up":   { "duration_ms": 900 },
    "dragged":   { "duration_ms": 500, "loop": true },
    "despawn":   { "duration_ms": 500 },
    "wave":      { "duration_ms": 1200 }
  },
  "actions": {
    "spawn":     { "animation": "spawn", "priority": 3, "interruptible": false },
    "idle":      { "animation": "idle" },
    "walk":      { "animation": "walk" },
    "run":       { "animation": "run" },
    "look":      { "animation": "look" },
    "react":     { "animation": "react", "priority": 2 },
    "interact":  { "animation": "interact", "priority": 2 },
    "celebrate": { "animation": "celebrate", "priority": 5, "interruptible": false },
    "think":     { "animation": "think" },
    "busy":      { "animation": "busy" },
    "warning":   { "animation": "warning", "priority": 4, "interruptible": false },
    "error":     { "animation": "error", "priority": 4, "interruptible": false },
    "sleep":     { "animation": "sleep" },
    "wake_up":   { "animation": "wake_up", "priority": 2, "interruptible": false },
    "dragged":   { "animation": "dragged", "priority": 6 },
    "despawn":   { "animation": "despawn", "priority": 7, "interruptible": false },
    "wave":      { "animation": "wave", "priority": 1 }
  },
  "motion": { "walk_speed": 60, "run_speed": 240 },
  "behavior": {
    "nap_weight": 0.3,
    "approach_cursor_weight": 2.5,
    "chase_cursor_weight": 1.8,
