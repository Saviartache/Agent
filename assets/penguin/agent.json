{
  "id": "penguin",
  "rig": "penguin",
  "frame_size": [64, 64],
  "anchor": [32, 60],
  "scale": 1.0,
  "animations": {
    "spawn":     { "frames": { "count": 8,  "duration_ms": 75 } },
    "idle":      { "frames": { "count": 8,  "duration_ms": 150 }, "loop": true },
    "walk":      { "frames": { "count": 8,  "duration_ms": 100 }, "loop": true },
    "run":       { "frames": { "count": 5,  "duration_ms": 100 }, "loop": true },
    "look":      { "frames": { "count": 8,  "duration_ms": 125 } },
    "react":     { "frames": { "count": 5,  "duration_ms": 100 } },
    "interact":  { "frames": { "count": 7,  "duration_ms": 100 } },
    "celebrate": { "frames": { "count": 12, "duration_ms": 100 } },
    "think":     { "frames": { "count": 8,  "duration_ms": 300 }, "loop": true },
    "busy":      { "frames": { "count": 10, "duration_ms": 100 }, "loop": true },
    "warning":   { "frames": { "count": 10, "duration_ms": 100 } },
    "error":     { "frames": { "count": 12, "duration_ms": 100 } },
    "sleep":     { "frames": { "count": 13, "duration_ms": 200 }, "loop": true },
    "wake_up":   { "frames": { "count": 9,  "duration_ms": 100 } },
    "dragged":   { "frames": { "count": 5,  "duration_ms": 100 }, "loop": true },
    "despawn":   { "frames": { "count": 5,  "duration_ms": 100 } },
    "wave":      { "frames": { "count": 12, "duration_ms": 100 } }
  },
  "actions": {
    "spawn":     { "animation": "spawn", "priority": 3, "interruptible": false },
    "idle":      { "animation": "idle" },
    "walk":      { "animation": "walk" },
    "run":       { "animation": "run" },
    "look":      { "animation": "look" },
    "react":     { "animation": "react", "priority": 2 },
    "interact":  { "animation": "interact", "priority": 2 },
    "celebrate": { "animation": "celebrate", "priority": 5, "interruptible": false },
    "think":     { "animation": "think" },
    "busy":      { "animation": "busy" },
    "warning":   { "animation": "warning", "priority": 4, "interruptible": false },
    "error":     { "animation": "error", "priority": 4, "interruptible": false },
    "sleep":     { "animation": "sleep" },
    "wake_up":   { "animation": "wake_up", "priority": 2, "interruptible": false },
    "dragged":   { "animation": "dragged", "priority": 6 },
    "despawn":   { "animation": "despawn", "priority": 7, "interruptible": false },
    "wave":      { "animation": "wave", "priority": 1 }
  },
  "motion": { "walk_speed": 60, "run_speed": 210 },
  "behavior": { "nap_weight": 0.3 }
}
